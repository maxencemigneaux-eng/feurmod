{
  "schemaVersion": 1,
  "id": "feurmod",
  "version": "${version}",
  "name": "Feurmod",
  "description": "Les mods Cobblemon de FeurIndustry en un seul : bouton « Annuler » en combat (comme Showdown), fiche Pokémon /feurinfo (modèle 3D, talents, stats, attaques) et calculateur de dégâts façon Showdex (/feurcalc, touche J) et timers des légendaires toujours affichés (ex-Feurleg). Calculs : @smogon/calc (MIT).",
  "authors": [
    "FeurIndustry"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.goat.cobblemonundo.CobblemonUndo"
    ],
    "client": [
      "com.goat.cobblemonundo.client.CobblemonUndoClient",
      "com.goat.feurinfo.FeurinfoClient",
      "com.goat.feurcalc.FeurcalcClient",
      "com.goat.feurleg.FeurlegClient",
      "com.goat.feurmod.FeurmodClient"
    ]
  },
  "mixins": [
    "cobblemon_undo.mixins.json",
    {
      "config": "feurleg.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "cobblemon": ">=1.8.0"
  },
  "breaks": {
    "cobblemon_undo": "*",
    "feurinfo": "*",
    "feurcalc": "*",
    "feurleg": "*"
  }
}
